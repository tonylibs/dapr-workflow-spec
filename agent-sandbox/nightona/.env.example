# Env vars read directly by the Omnigent SERVER process (by the `daytona` python SDK
# client Omnigent's daytona.py launcher constructs) -- these are process env, not part of
# Omnigent's config.yaml. Export them wherever `omnigent serve` / the Omnigent control
# plane actually runs, before it starts.
#
# Get DAYTONA_API_KEY from the Nightona dashboard after `docker compose up`:
#   http://localhost:3000/dashboard -> login dev@daytona.io / password -> create API key.
DAYTONA_API_KEY=replace-with-nightona-api-key
DAYTONA_API_URL=http://localhost:3000/api
# Only needed if you configured more than one runner/region in Nightona; the compose
# stack ships a single default runner/region, so this is usually unset.
# DAYTONA_TARGET=us
