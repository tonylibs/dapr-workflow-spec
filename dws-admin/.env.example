# HTTP port the Nest app listens on.
PORT=3000

# Postgres connection string (matches docker-compose.yml's mapped port 5433).
DATABASE_URL=postgres://dws:dws@localhost:5433/dws_admin

# Run drizzle-orm migrations on boot before the app starts listening.
# Set to "false" for a deploy pipeline that runs `pnpm db:migrate` as a
# separate step instead.
RUN_MIGRATIONS_ON_BOOT=true

# Dapr pub/sub component name and topic this service subscribes to.
# Must match the deployment-wide values documented in docs/events.md.
DAPR_PUBSUB_NAME=pubsub
DAPR_PUBSUB_TOPIC=dws.events

# Dapr sidecar wiring for @dbc-tech/nest-dapr (DaprModule). Its DaprServer runs
# its OWN HTTP listener — separate from Nest's Express app on PORT above — to
# receive pubsub/binding callbacks from the sidecar. DAPR_APP_PORT must be
# different from PORT, and `dapr run --app-port` must target DAPR_APP_PORT,
# not PORT (see README's "Run under a Dapr sidecar" section).
DAPR_APP_PORT=3001
# DAPR_HOST=127.0.0.1
# DAPR_HTTP_PORT=3500
