# Base URL the console fetches the dws-admin read API from.
#
# Local development: leave this as the proxy prefix below. `vite.config.ts`
# forwards /dws-admin to DWS_ADMIN_PROXY_TARGET (default http://127.0.0.1:3001),
# keeping the calls same-origin so no CORS round-trip is involved at all.
VITE_DWS_ADMIN_URL=/dws-admin

# Where the dev-server proxy forwards those calls. Only read by vite.config.ts
# in development; ignored by a production build.
DWS_ADMIN_PROXY_TARGET=http://127.0.0.1:3001

# Calling dws-admin directly, cross-origin, also works: it sends CORS headers,
# allowing any origin by default and narrowable with its CORS_ORIGINS variable.
# Point VITE_DWS_ADMIN_URL at its absolute URL (e.g. http://localhost:3001) to
# skip the proxy.
#
# Deployed: put the console and dws-admin behind one ingress and set this to the
# path dws-admin is routed at, or use its absolute URL with CORS_ORIGINS set to
# the console's origin.

# ── OIDC login (auth roadmap Phase 1) ────────────────────────────────────────
#
# The console signs operators in against an OIDC provider (Dex, deployed by
# charts/dws with dex.enabled=true) using Authorization Code + PKCE as a public
# client. The access token is held in memory only, never in web storage.
#
# Issuer URL — must match Dex's own `issuer` value (charts/dws values.yaml
# dex.issuer), because it is the `iss` claim tokens are minted with and the base
# for OIDC discovery at <issuer>/.well-known/openid-configuration.
#
# DEV CAVEAT: the chart's default issuer is http://dex.dws.local/dex, a
# placeholder host that does not resolve on its own. To sign in locally you need
# that host resolvable — add it to /etc/hosts pointing at your ingress, or
# port-forward Dex and override both this value and dex.issuer to the forwarded
# URL so the two agree. Leaving it unresolvable only disables sign-in; the rest
# of the console keeps working.
VITE_OIDC_ISSUER_URI=http://dex.dws.local/dex

# The public client id registered for the console in Dex's staticClients
# (charts/dws templates/_helpers.tpl, "dws.dex.config"). Defaults to dws-console
# when unset; override only if the client is registered under another id.
VITE_OIDC_CLIENT_ID=dws-console

# Space-separated extra scopes requested at login. "openid" is always added by
# the client library, so list only the additional ones. Defaults to
# "profile email" when unset.
VITE_OIDC_SCOPES=profile email

# NOTE: there is no redirect-URI setting here on purpose. The client library
# (oidc-spa) always uses the app's own root URL as the OIDC redirect URI, which
# is what keeps one build working across dev and deployed origins. Dex must have
# that exact root URL registered as the console client's redirect URI
# (charts/dws values.yaml dex.consoleRedirectURI, default http://localhost:3000/
# to match `pnpm dev`'s port).
