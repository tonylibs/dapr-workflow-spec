# Base URL the console fetches the dws-admin read API from.
#
# Local development: leave this as the proxy prefix below. `vite.config.ts`
# forwards /dws-admin to DWS_ADMIN_PROXY_TARGET (default http://127.0.0.1:3001),
# which keeps the calls same-origin — dws-admin serves no CORS headers, so a
# browser cannot call it cross-origin directly.
VITE_DWS_ADMIN_URL=/dws-admin

# Where the dev-server proxy forwards those calls. Only read by vite.config.ts
# in development; ignored by a production build.
DWS_ADMIN_PROXY_TARGET=http://127.0.0.1:3001

# Deployed: leave VITE_DWS_ADMIN_URL empty to call the same origin (console and
# dws-admin behind one ingress), or set an absolute URL only if dws-admin is
# configured to allow the console's origin.
