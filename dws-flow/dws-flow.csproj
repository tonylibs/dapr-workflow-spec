<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- version.txt is the single version source: release-please bumps it, the build reads it. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version.txt').Trim())</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapr.Client" Version="1.18.5" />
    <PackageReference Include="Dapr.Workflow" Version="1.18.5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="test/**/*.cs" />
  </ItemGroup>
</Project>
