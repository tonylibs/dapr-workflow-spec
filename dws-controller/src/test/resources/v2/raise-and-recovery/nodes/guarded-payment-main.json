{
  "workflow" : "guarded-payment",
  "version" : "guarded-payment@<versionId>",
  "nodeId" : "guarded-payment-main",
  "kind" : "flow",
  "scope" : "main",
  "tasks" : [ {
    "processPayment" : {
      "try" : [ {
        "rejectPayment" : {
          "raise" : {
            "error" : {
              "type" : "https://example.com/errors/payment-rejected",
              "status" : 402,
              "title" : "Payment rejected",
              "detail" : "Payment authorization failed"
            }
          }
        }
      } ],
      "catch" : {
        "errors" : {
          "with" : {
            "status" : 402
          }
        },
        "do" : [ {
          "recordFailure" : {
            "set" : {
              "status" : "failed"
            }
          }
        } ]
      },
      "then" : "end"
    }
  } ],
  "children" : {
    "processPayment" : "process-payment"
  }
}
