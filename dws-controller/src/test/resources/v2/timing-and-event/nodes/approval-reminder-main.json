{
  "workflow" : "approval-reminder",
  "version" : "approval-reminder@<versionId>",
  "nodeId" : "approval-reminder-main",
  "kind" : "flow",
  "scope" : "main",
  "tasks" : [ {
    "reminderDelay" : {
      "wait" : "PT5M"
    }
  }, {
    "awaitApproval" : {
      "listen" : {
        "to" : {
          "one" : {
            "with" : {
              "type" : "com.example.request.approved"
            }
          }
        }
      }
    }
  }, {
    "publishCompletion" : {
      "emit" : {
        "event" : {
          "with" : {
            "source" : "https://workflow.example.com/approval-reminder",
            "type" : "com.example.request.completed",
            "data" : "${ . }"
          }
        }
      },
      "then" : "end"
    }
  } ],
  "children" : {
    "reminderDelay" : "reminder-delay",
    "awaitApproval" : "await-approval",
    "publishCompletion" : "publish-completion"
  }
}
