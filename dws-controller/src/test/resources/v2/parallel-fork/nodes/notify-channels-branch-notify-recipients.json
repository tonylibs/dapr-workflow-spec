{
  "workflow" : "notify-order",
  "version" : "notify-order@<versionId>",
  "nodeId" : "notify-channels-branch-notify-recipients",
  "kind" : "flow",
  "scope" : "forkBranch",
  "tasks" : [ {
    "notifyRecipients" : {
      "for" : {
        "each" : "recipient",
        "in" : ".recipients"
      },
      "do" : [ {
        "sendEmail" : {
          "call" : "http",
          "with" : {
            "method" : "post",
            "endpoint" : "https://email.example.com/send"
          }
        }
      } ]
    }
  } ],
  "children" : {
    "notifyRecipients" : "notify-recipients"
  }
}
