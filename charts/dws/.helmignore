# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Chart render tests and their fixtures. Run from a repo checkout by
# .github/workflows/helm.yml, never from a packaged chart — and the default-render
# baseline fixture alone is ~100KB of dead weight in every published release.
# Leading slash anchors this to the chart root so templates/tests/ (the real
# `helm test` hooks) is NOT excluded.
/tests/
